{
  "manifest_version": 3,
  "name": "Яндекс.Диск: скачивание альбомов",
  "version": "1.3.1",
  "description": "Скачивает фотографии из альбомов Яндекс.Диска в выбранную папку (в максимальном доступном размере).",
  "permissions": [
    "declarativeNetRequest",
    "cookies"
  ],
  "host_permissions": [
    "https://*.yandex.ru/*",
    "https://*.yandex.net/*",
    "https://*.yandex.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Скачать альбомы Яндекс.Диска"
  }
}